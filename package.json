{
  "name": "small-mcq-exam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node server/app.js\"",
    "start": "node server/app.js",
